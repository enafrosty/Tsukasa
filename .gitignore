# Build artifacts (regenerated by `make`)
*.o
*.d
*.a
*.elf
*.bin
*.efi
*.img
*.iso
*.exe

# Boot / ISO staging outputs
iso/boot/*.elf
iso/boot/*.img
iso/boot/limine/*.bin
iso/boot/limine/*.sys
iso/EFI/BOOT/*.EFI

# Built user programs (no extension)
user/hello_gui
user/sample_cli

# Runtime / QEMU
*.log
*.pid
.last_build_arch
qemu.pid

bootblob.bin
.bootblob-template.img
target.img
gpt-test.img
mbr-test.img
disk.img
scratch.img
serial-*.log
qemu-*.err

# Documentation & Report artifacts
info/
info

# SDK staging output (regenerated by `make sdk`)
sdk/

# SDK staging output (regenerated by `make sdk`)
sdk/

# Limine bootloader (cloned by `make limine-artifacts`)
.limine/

# Generated kernel symbols table
lib/ksymbols_table.c

# Uppercase guest ELF binaries (case-sensitive filesystems)
*.ELF

# Generated initrd assets copied from vanilla/ during build
initrd_files/TSUKASA.VCO
initrd_files/ICONS/TSUKASA.VCO
initrd_files/WALLPAP.BMP
initrd_files/WALLPAP.PNG

# Host emulator and QMP visual test outputs
vanilla/host_emulator/bin/
tmp-visual-test/
